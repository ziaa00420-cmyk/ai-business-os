# Copy to .env. Never commit .env.

# API
DATABASE_URL=postgresql+psycopg://aibos_app:aibos_app@localhost:5432/aibos
MIGRATIONS_DATABASE_URL=postgresql+psycopg://aibos:aibos@localhost:5432/aibos
AUTH_MODE=dev                 # dev | clerk
CLERK_JWKS_URL=               # https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=                 # https://<your-clerk-domain>
ANTHROPIC_API_KEY=            # optional; without it, drafts come from the owner's answers and PDF import is off
AGENT_MODEL=claude-sonnet-5-5
STORAGE_DIR=./storage

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
